# Sao chép thành .env.local rồi điền. KHÔNG commit .env.local.

# Gốc URL backend. ĐỂ TRỐNG = chưa có backend: đăng nhập MẪU (khach@fitly.vn / Demo123456!),
# giỏ/đơn hàng lưu ở trình duyệt. Có backend NestJS eco_fashion thì đặt http://localhost:4000
# (tài khoản seed: khach1@ecofashion.vn / Khach123456!).
NEXT_PUBLIC_API_URL=

# URL OpenAPI spec cho `npm run api:spec` (NestJS eco_fashion: /docs/openapi.json).
API_SPEC_URL=http://localhost:4000/docs/openapi.json

# Google OAuth Client ID (lấy từ Google Cloud Console — trùng với EF_GOOGLE_CLIENT_ID ở backend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
