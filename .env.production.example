# Biến môi trường khi deploy lên Vercel (Project → Settings → Environment Variables, môi trường Production). Đổi xong phải Redeploy
# (biến NEXT_PUBLIC_* được nhúng lúc build).

# URL HTTPS của backend (eco_backend, xem docs/08_DEPLOY.md ở repo backend). KHÔNG để trống: trống = chế độ dữ liệu mẫu, không gọi backend.
# Trình duyệt gọi THẲNG backend nên origin của web này (https://<tên-project>.vercel.app) phải nằm trong EF_CORS_ORIGINS của backend.
NEXT_PUBLIC_API_URL=https://api.160.191.242.187.sslip.io

# Google OAuth Client ID (public, trùng EF_GOOGLE_CLIENT_ID ở backend). Origin của web này phải được thêm vào "Authorized JavaScript origins" trong Google Cloud Console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# URL web quản trị (cổng nhà cung cấp, repo fashion_frontend_admin), ví dụ https://admin.<tên-miền>. Tuỳ chọn (PLAN-0009): có giá trị thì trang /sell
# hiện nút "Mở trang quản lý gian hàng" khi hồ sơ đăng ký bán hàng được duyệt; để TRỐNG thì chỉ hiện hướng dẫn bằng chữ. Chỉ nhận http(s).
NEXT_PUBLIC_ADMIN_URL=
